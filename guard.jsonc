{
  "$schema": "./extensions/guard/guard.schema.json",
  "defaultTier": "on",
  "mode": "balanced",
  "warnPolicy": "prompt",
  // dirs that are auto allowed to be read without prompting
  "allowedReadDirs": ["/nix", "~/.rustup", "~/.cargo", "/tmp"],
  // dirs that will be mounted rw instead of only ro
  "writableDirs": ["~/.cargo", "~/.rustup", "~/.cache", "~/.local/share", "~/.config", "~/.npm"],
  // hosts the default `on` tier may reach — the tier is always proxy-only
  // egress: no network interfaces, all traffic through a local proxy that
  // enforces this list (patterns: github.com, *.github.com, github.com:443).
  // Hosts matching neither list prompt the human (Allow/Deny per session);
  // an empty list means every host prompts. Starter set for the common
  // dev-fetch hosts — trim or extend freely.
  "allowedHosts": [
    "github.com",
    "*.github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "registry.npmjs.org",
    "crates.io",
    "*.crates.io",
    "cache.nixos.org",
    "channels.nixos.org",
    "nixos.org"
  ],
  // always-denied hosts, checked before allowedHosts (no prompt); `*` denies all
  "deniedHosts": [],
  "overrides": {
    "allowHeads": [],
    "denyHeads": [],
    "allowPaths": [],
    "denyPaths": []
  }
}
