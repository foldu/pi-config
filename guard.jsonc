{
  "$schema": "./extensions/guard/guard.schema.json",
  "defaultTier": "on",
  "mode": "balanced",
  "warnPolicy": "prompt",
  // dirs that are auto allowed to be read without prompting
  "allowedReadDirs": ["/nix", "~/.rustup", "~/.cargo", "/tmp"],
  // dirs bound rw into the sandbox; everything else outside the project is
  // invisible (the sandbox starts from an empty root — only these, the
  // project, and the system closure are bound in)
  "writableDirs": ["~/.cargo", "~/.rustup", "~/.cache", "~/.local/share", "~/.config", "~/.npm"],
  // hosts the default `on` tier may reach — the tier is always proxy-only
  // egress: no network interfaces, all traffic through a local proxy that
  // enforces this list (patterns: github.com, *.github.com, github.com:443).
  // Hosts matching neither list prompt the human (Allow/Deny per session);
  // an empty list means every host prompts. Starter set for the common
  // dev-fetch hosts — trim or extend freely.
  "allowedHosts": [
    "github.com",
    "*.github.com",
    "raw.githubusercontent.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "registry.npmjs.org",
    "crates.io",
    "*.crates.io",
    "cache.nixos.org",
    "channels.nixos.org",
    "nixos.org",
  ],
  // always-denied hosts, checked before allowedHosts (no prompt); `*` denies all
  "deniedHosts": [],
  // env vars passed through to sandboxed commands (everything else is
  // stripped — the sandbox starts from an empty env). Secrets are opt-in:
  // e.g. ["CARGO_REGISTRY_TOKEN"] if cargo needs it.
  "allowedEnv": [],
  // per-class command overrides: { "WRITE_LOCAL": ["nix"] } reclassifies
  // nix to be a low risk local write.
  // add your own commands to here, but really _think_ about your classification
  "commandClasses": {
    "WRITE_LOCAL": ["nix", "nix-build", "nix-shell", "nix-env", "nix-collect-garbage"],
    "PRIVILEGE_OR_PERMISSION": ["nixos-rebuild"],
  },
  // paths whose contents are hidden inside the sandbox (stricter than
  // read-only): directories become empty tmpfs, files become /dev/null, so
  // sandboxed commands can't read identity material at all
  "hiddenPaths": [],
  "overrides": {
    "allowHeads": [],
    "denyHeads": [],
    "allowPaths": [],
    "denyPaths": [],
  },
}
